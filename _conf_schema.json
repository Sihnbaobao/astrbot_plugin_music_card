{
  "COMMENT_DAILY_LIMIT": {
    "description": "每日评论上限",
    "type": "int",
    "default": 3,
    "hint": "0 表示不允许发评论。"
  },
  "AUTO_COMMENT": {
    "description": "听完自动评论",
    "type": "bool",
    "default": false,
    "hint": "插件页手动听歌时，开启后它会把听后感发到评论区。"
  },
  "LISTEN_QUERY": {
    "description": "手动听歌的默认搜索词",
    "type": "string",
    "default": "花谱",
    "hint": "插件页点「听一首」时用它去网易云搜歌，可以填歌名或歌手名。"
  },
  "PERSONA_ID": {
    "description": "听歌时用的人格",
    "type": "string",
    "default": "",
    "hint": "留空则只按提示词写听后感，不加载人格。"
  },
  "PERSONA_EXTRA": {
    "description": "听歌人格补充",
    "type": "string",
    "default": "",
    "hint": "追加在人格后面的额外说明，只用于插件页听歌和评论；可以写发评论时的口径限制。"
  },
  "REPLY_WATCH": {
    "description": "检查评论回复",
    "type": "bool",
    "default": true,
    "hint": "定时检查自己评论下有没有新回复。"
  },
  "AUTO_REPLY": {
    "description": "自动回复评论",
    "type": "bool",
    "default": false,
    "hint": "有人回复你的评论时，自动用听歌人格回一句；关闭则只在插件页展示。"
  },
  "REPLY_INTERVAL_MINUTES": {
    "description": "回复检查间隔（分钟）",
    "type": "int",
    "default": 30,
    "hint": "默认 30 分钟；只查最近 5 条、7 天内的评论，避免请求太频繁。"
  },
  "REPLY_DAILY_LIMIT": {
    "description": "每日自动回复上限",
    "type": "int",
    "default": 5,
    "hint": "0 表示不自动回复。"
  },
  "PROVIDER_ID": {
    "description": "听歌时用的模型",
    "type": "string",
    "default": "",
    "hint": "留空使用当前聊天模型。"
  },
  "AUTO_SAVE": {
    "description": "听完自动收藏",
    "type": "bool",
    "default": false,
    "hint": "听完评分达到阈值时，自动红心并加入歌单。"
  },
  "LIKE_MIN_SCORE": {
    "description": "收藏分数阈值",
    "type": "int",
    "default": 9,
    "hint": "必须同时满足 like=true 且评分达到这个值才收藏（1-10）。"
  },
  "PLAYLIST_PREFIX": {
    "description": "歌单名前缀",
    "type": "string",
    "default": "璃月",
    "hint": "自动创建的歌单名格式：前缀·分类。"
  },
  "PLAYLIST_CATEGORIES": {
    "description": "歌单分类",
    "type": "string",
    "default": "深夜,通勤,元气,emo",
    "hint": "逗号分隔，模型会从里面挑一个作为歌单分类。"
  },
  "LISTEN_SHARED": {
    "description": "听别人分享的歌",
    "type": "bool",
    "default": true,
    "hint": "有人分享音乐链接时，自动听一遍并回一句听后感；卡片则由模型决定是否听。"
  },
  "AUTO_LISTEN": {
    "description": "自己定时听歌",
    "type": "bool",
    "default": false,
    "hint": "到点先问人格想不想听；想听才去听。"
  },
  "AUTO_LISTEN_TIMES": {
    "description": "想听歌的时间点",
    "type": "string",
    "default": "10:00,15:00,21:00",
    "hint": "逗号分隔的 24 小时时间，如 10:00,15:00,21:00。"
  },
  "AUTO_LISTEN_UMO": {
    "description": "听歌后推送到",
    "type": "string",
    "default": "",
    "hint": "会话 UMO，留空只记录不推送。"
  }
}
